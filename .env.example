# PhoneMail configuration. Copy to .env only if you want to change something:
# `docker compose up -d` works with no .env at all (demo mode, zero credentials).
# Empty values fall back to the defaults in apps/server/src/config/env.ts.

# --- General -----------------------------------------------------------------
# Domain of every address: 9876543210@phonemail.com
MAIL_DOMAIN=phonemail.com
# Where people reach the app. Used in SMS links, Twilio signature checks and
# WebOTP. Set it to the https://….trycloudflare.com URL when using the tunnel
# (scripts/public-url.sh does this for you).
PUBLIC_BASE_URL=http://localhost:8080
# true = console SMS provider, demo console at /demo, demo code banners, seed data.
DEMO_MODE=true
# otp, password or both (OTP first, "Use password instead").
AUTH_MODE=otp
# Country assumed for numbers typed without a country code.
DEFAULT_COUNTRY=IN
# debug, info, warn, error
LOG_LEVEL=info

# --- Secrets (change for anything public; a warning is logged when DEMO_MODE=false
# and these are left at their development defaults) ------------------------------
# Signs the 15-minute access tokens (JWT, HS256). Use 32+ random characters.
JWT_SECRET=
# Mixed into OTP hashes (HMAC-SHA256) so a Redis dump can't reveal codes.
OTP_PEPPER=
# Signs the short-lived tokens the api uses to submit mail to the SMTP server.
INTERNAL_SMTP_SECRET=

# --- Database (compose builds DATABASE_URL from these) --------------------------
POSTGRES_USER=phonemail
POSTGRES_PASSWORD=phonemail
POSTGRES_DB=phonemail

# --- SMS providers ------------------------------------------------------------
# Priority order; unconfigured providers are skipped. console only works in demo mode.
SMS_PROVIDERS=smsgate,twilio,console
# auto (best available), local (our own codes), or twilio_verify.
OTP_PROVIDER=auto
# Minimum seconds between two SMS alerts for the same user and sender (0 = off).
SMS_NOTIFY_COOLDOWN_SECONDS=0
# Code requests allowed per IP per hour. Everything from your own laptop reaches
# Docker from one IP address, so raise this (e.g. 200) while testing locally.
OTP_IP_LIMIT_PER_HOUR=20

# --- Twilio (optional; free trial works) -------------------------------------
# From console.twilio.com. Use a US *local* number: US toll-free numbers can't
# be dialled from India.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Trial accounts can only send Twilio's SMS templates, not custom text.
TWILIO_TRIAL=true
# The template sent while on trial (copy it from the console's "Try out SMS" page).
TWILIO_SMS_TEMPLATE=sms_account_alerts
# Enables Twilio Verify as an OTP path (trial: verified numbers only).
TWILIO_VERIFY_SERVICE_SID=
# IVR voice (Indian English). Remove to use Twilio's default voice.
TWILIO_VOICE=Polly.Aditi

# --- SMSGate (optional; an Android phone as the SMS gateway) ------------------
# Cloud mode API. Credentials are shown in the SMSGate app.
SMSGATE_API_URL=https://api.sms-gate.app/3rdparty/v1
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
# Secret path segment of the inbound SMS webhook: /webhooks/smsgate/<secret>
SMSGATE_WEBHOOK_SECRET=
# Inbound texts to the gateway phone must start with this word to sign up,
# because a personal phone also receives bank OTPs and private messages.
# "*" accepts any text (only for a phone used just for PhoneMail).
SMSGATE_SIGNUP_KEYWORD=JOIN
# Optional: the webhook "signing key" from the SMSGate app settings. When set,
# every inbound-SMS webhook must carry a valid HMAC signature.
SMSGATE_SIGNING_KEY=

# --- Outbound mail to other domains --------------------------------------------
# Demo mode relays to Mailpit (http://localhost:8025) so nothing leaves your machine.
SMTP_RELAY_HOST=mailpit
SMTP_RELAY_PORT=1025
SMTP_RELAY_USER=
SMTP_RELAY_PASS=
