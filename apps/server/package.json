{
  "name": "@phonemail/server",
  "version": "0.1.0",
  "private": true,
  "description": "PhoneMail backend: REST API, SMTP server and background worker.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx watch --env-file-if-exists=../../.env src/entry/api.ts",
    "dev:smtp": "tsx watch --env-file-if-exists=../../.env src/entry/smtp.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/entry/worker.ts",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.1",
    "@phonemail/shared": "*",
    "@prisma/client": "~6.19.3",
    "bullmq": "^5.81.5",
    "fastify": "^5.12.5",
    "ioredis": "5.11.1",
    "pino": "^10.3.1",
    "prisma": "~6.19.3",
    "smtp-server": "^3.19.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/smtp-server": "^3.5.13",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "vitest": "^4.1.11"
  }
}
